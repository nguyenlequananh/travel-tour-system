# ================= STAGE 1: BUILD SPRING BOOT VỚI MAVEN =================
FROM maven:3.9-eclipse-temurin-17-alpine AS build
WORKDIR /app

# Copy file cấu hình Maven và cache dependencies
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copy mã nguồn và đóng gói file JAR
COPY src ./src
RUN mvn clean package -DskipTests

# ================= STAGE 2: CHẠY ỨNG DỤNG VỚI RUNTIME JRE SIÊU NHẸ =================
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Thiết lập múi giờ Việt Nam trong Linux Container (Khắc phục lỗi lệch giờ VNPay)
ENV TZ=Asia/Ho_Chi_Minh
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone

# Copy file .jar đã đóng gói từ Stage 1
COPY --from=build /app/target/*.jar app.jar

EXPOSE 8081

# Tối ưu hóa bộ nhớ RAM cho máy chủ Cloud VPS (Dành tối đa 600MB cho Spring Boot)
ENTRYPOINT ["java", "-Xmx600m", "-Xms256m", "-jar", "app.jar"]
